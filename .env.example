# Copy to .env and fill in real values (never commit .env)
#   Copy-Item .env.example .env

# Anousith — auto-login when auth.json session expires
ANOUSITH_USER=
ANOUSITH_PASSWORD=

# HAL express — capture_bill_hal.py
HAL_USER=
HAL_PASSWORD=
# HAL_LOGIN_URL=https://www.halexpress.la/login
# HAL_OUTBOUND_LIST_URL=https://www.halexpress.la/parcel/outbound

# Messenger webhook (messenger_webhook_server.py)
WEBHOOK_VERIFY_TOKEN=my_verify_token_12345
PORT=5000

# Public URL / ngrok (Bill_Automation_Kit launcher reads these)
# NGROK_DOMAIN=your-subdomain.ngrok-free.dev
# BASE_URL=https://your-subdomain.ngrok-free.dev

# Webhook features (optional)
# ENABLE_MESSAGING=1
# ENABLE_FEED=0
# WELCOME_SEND_DELAY=0.6
# PROMO_SEND_DELAY=0.8
